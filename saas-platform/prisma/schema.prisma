// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  password          String
  twilioSid         String?
  twilioToken       String?
  twilioPhone       String?
  googleRefreshToken String?
  campaigns         Campaign[]
  createdAt         DateTime   @default(now())
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("idle") // idle, running, paused, completed
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  leads     Lead[]
  createdAt DateTime @default(now())
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  status      String   @default("pending") // legacy composite: call lifecycle OR outcome (kept for dial/skip compat)
  callStatus  String   @default("pending") // pending|calling|answered|not answered|call completed|call ended|failed
  outcomeStatus String @default("unknown") // unknown|interested|follow up|visit scheduled|not interested
  duration    String?
  summary     String?
  interested  Boolean?
  appointmentTime DateTime?
  transcription String?
  recordingUrl String?
  lastResponse String?
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  createdAt   DateTime @default(now())
}
