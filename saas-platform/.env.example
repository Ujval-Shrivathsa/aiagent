# Copy this file to .env and fill in values from the Supabase dashboard.
# Project Settings → API  and  Project Settings → Database

# --- App (existing) ---
GEMINI_API_KEY="your_gemini_key"
GROQ_API_KEY="your_groq_key"
JWT_SECRET="change-me"
APP_URL="https://your-ngrok-url.ngrok-free.app"
VOICE_SERVER_URL="https://your-ngrok-url.ngrok-free.app"

# Gemini Live voice — Sulafat (warm), Kore (firm), Achernar (soft), Aoede (breezy), etc.
# VOICE_TTS_VOICE_NAME=Sulafat
# VOICE_TTS_VOICE_NAME_EN=Sulafat
# VOICE_TTS_LANGUAGE_CODE=kn-IN
# Audio pipeline — quiet speech pickup + fast turn (~250ms) + background noise rejection
# VOICE_INPUT_GAIN=2.15
# VOICE_GATE_OPEN_MIN_RMS=165
# VOICE_GATE_FLOOR=0.48
# VOICE_BARGE_IN_MIN_RMS=2000
# VOICE_BARGE_IN_FLOOR_MULT=7.5
# VOICE_BARGE_IN_MIN_MS=400
# VOICE_INPUT_GAIN=2.45
# VOICE_GATE_OPEN_MIN_RMS=120
# VOICE_GATE_FLOOR=0.62
# VOICE_GATE_FLOOR_MULT=1.95
# VOICE_SPEECH_LIKE_GATE_FLOOR=0.78
# VOICE_SPEECH_MIN_CREST=2.15
# VOICE_SPEECH_MIN_ZCR=0.038
# VOICE_VAD_ENERGY_MIN_RMS=175
# VOICE_VAD_ENERGY_FLOOR_MULT=1.85
# VOICE_AAD_SILENCE_MS=25
# VOICE_VAD_SILENCE_MS=25
# VOICE_AAD_PREFIX_PADDING_MS=25
# VOICE_AAD_START_SENSITIVITY=START_SENSITIVITY_HIGH
# VOICE_AAD_END_SENSITIVITY=END_SENSITIVITY_LOW
# VOICE_RESPONSE_WATCHDOG_MS=500

VOICE_PROVIDER=plivo
PLIVO_AUTH_ID="your_plivo_auth_id"
PLIVO_AUTH_TOKEN="your_plivo_auth_token"
PLIVO_PHONE_NUMBER="+91xxxxxxxxxx"

# Local call recording + live STT (Gemini input transcription on the live call).
# Do not use Plivo's recording API.
RECORDINGS_DIR="./recordings"
CALL_LOGS_DIR="./call_logs"
RECORDING_SAMPLE_RATE=8000
# Customer channel post-processing in the WAV (does not affect the live call)
RECORDING_CUSTOMER_GAIN=3.5
RECORDING_NOISE_GATE_RMS=260
STT_PROVIDER=gemini
TWILIO_ACCOUNT_SID="your_sid"
TWILIO_AUTH_TOKEN="your_token"
TWILIO_PHONE_NUMBER="your_twilio_number"

# Local SQLite is not used on Vercel. Set DATABASE_URL to the Supabase Postgres URI.
DATABASE_URL="postgresql://postgres.pvzoznzvpzllwooozrhm:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Supabase API ---
NEXT_PUBLIC_SUPABASE_URL="https://pvzoznzvpzllwooozrhm.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# --- Supabase Postgres (ap-northeast-1) ---
# Session pooler (app): port 6543. Direct (migrations): port 5432.
# After pasting the DB password, change prisma/schema.prisma provider from sqlite to postgresql.
SUPABASE_DATABASE_URL="postgresql://postgres.pvzoznzvpzllwooozrhm:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.pvzoznzvpzllwooozrhm:YOUR_DB_PASSWORD@db.pvzoznzvpzllwooozrhm.supabase.co:5432/postgres"

# --- Supabase Storage (S3-compatible) ---
SUPABASE_STORAGE_BUCKET="recordings"
SUPABASE_S3_ENDPOINT="https://pvzoznzvpzllwooozrhm.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="ap-northeast-1"
