# GEMINI_API_KEY: Required when VOICE_STACK=gemini (Live native audio).
GEMINI_API_KEY="your_gemini_key"

# Voice brain: sarvam (default) | gemini
# Revert to Gemini Live anytime with VOICE_STACK=gemini
VOICE_STACK=sarvam

# Sarvam AI (STT Saaras realtime + LLM + TTS Bulbul) — required when VOICE_STACK=sarvam
SARVAM_API_KEY=sk_your_sarvam_key_here
# SARVAM_CHAT_MODEL=sarvam-105b-conversations
# Faster LLM option: SARVAM_CHAT_MODEL=sarvam-30b
# SARVAM_STT_MODEL=saaras:v3-realtime
# SARVAM_STT_SILENCE_MS=400
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=ishita
# SARVAM_TTS_PACE=1.08
# SARVAM_TTS_MIN_BUFFER=20
# SARVAM_MAX_TOKENS=160

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here
SESSION_SECRET=change-me
APP_URL=https://your-ngrok-url.ngrok-free.app

# TWILIO (optional if using Plivo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# PLIVO (replace with your Plivo credentials)
VOICE_PROVIDER=plivo
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_PHONE_NUMBER=+91xxxxxxxxxx

# Local recording + live STT (not Plivo Record)
RECORDINGS_DIR=./recordings
CALL_LOGS_DIR=./call_logs
STT_PROVIDER=sarvam
STT_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://pvzoznzvpzllwooozrhm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
DIRECT_URL=
SUPABASE_STORAGE_BUCKET=recordings
SUPABASE_S3_ENDPOINT=https://pvzoznzvpzllwooozrhm.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-northeast-1

# Gender/salutation confidence (voice agent addressing)
# VOICE_GENDER_CONFIDENCE_HIGH=0.90
# VOICE_GENDER_CONFIDENCE_MED=0.70

# Kannada-first opening (configurable without code changes)
# VOICE_OPENING_AGENT_NAME_KN=ಭೂಮಿ
# VOICE_OPENING_AGENT_NAME_EN=Bhoomi
# VOICE_OPENING_COMPANY_NAME=Alliance Square
# VOICE_OPENING_QUESTION_KN=ನೀವು plot ನೋಡ್ತಿದ್ದೀರಾ?
# VOICE_OPENING_QUESTION_EN=Are you looking for a plot?
# VOICE_OPENING_INCLUDE_NAME=1
# VOICE_TTS_LANGUAGE_CODE=kn-IN
# VOICE_TTS_VOICE_NAME=Kore

# Patient wait / silence (voice agent) — unexplained silence vs explicit "wait"
# VOICE_WAIT_AVAILABILITY_CHECK_MS=5000
# VOICE_WAIT_MAX_AVAILABILITY_CHECKS=2
# VOICE_WAIT_NEXT_CHECK_DELAY_MS=12000
# VOICE_WAIT_A_LITTLE_MS=12000
# VOICE_WAIT_JUST_A_MINUTE_MS=45000
# VOICE_WAIT_HOLD_ON_MS=12000
# VOICE_WAIT_GRACE_AFTER_CHECKS_MS=15000
# VOICE_WAIT_MAX_REQUESTED_MS=120000
# VOICE_WAIT_MIN_REQUESTED_MS=5000
